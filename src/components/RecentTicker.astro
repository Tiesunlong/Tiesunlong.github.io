---
/**
 * Hero "Recent publications" window: the newest peer-reviewed papers scroll
 * upwards in a seamless CSS loop (the list is rendered twice and translated
 * by -50%). Pauses on hover and focus; keyboard focus or reduced motion turns
 * it into a plain scrollable list. The clone is aria-hidden and untabbable, so
 * assistive tech and the Tab key see every paper exactly once.
 */
import Icon from './Icon.astro';
import { recentPublications, type Author, type Publication } from '../lib/data';
import { isExternal } from '../lib/format';

/** Below this the list is shorter than the window and a loop would show gaps. */
const MIN_FOR_LOOP = 4;
const items = recentPublications;
const loop = items.length >= MIN_FOR_LOOP;

/** First three authors; if the owner is further down, "A, B, … Owner". */
function shortAuthors(p: Publication): { shown: Author[]; skipped: boolean; more: boolean } {
  const named = p.authorList.filter((a) => !a.etAl);
  const ownerAt = named.findIndex((a) => a.isOwner);
  const owner = named[ownerAt];
  const shown = ownerAt >= 3 && owner ? [...named.slice(0, 2), owner] : named.slice(0, 3);
  const last = shown.at(-1);
  const more = (last ? named.indexOf(last) < named.length - 1 : false) || p.authorList.some((a) => a.etAl);
  return { shown, skipped: ownerAt >= 3, more };
}

const entries = items.map((p) => ({
  p,
  href: p.primaryLink ?? `/publications/#${p.id}`,
  // Skip the track chip when the venue name already says it ("ACL Findings").
  track: p.track && !p.venue.toLowerCase().includes(p.track.toLowerCase()) ? p.track : undefined,
  authors: shortAuthors(p),
}));
const copies = loop ? [0, 1] : [0];
---

{
  entries.length > 0 && (
    <section
      class:list={['recent', { 'recent--loop': loop }]}
      aria-labelledby="recent-title"
      style={`--ticker-items: ${entries.length}`}
    >
      <header class="head">
        <h2 id="recent-title" class="title">
          <span class="live" aria-hidden="true" />
          Recent publications
        </h2>
        <a class="all" href="/publications/">
          All
          <Icon name="arrow-right" />
        </a>
      </header>
      <div class="viewport">
        <ul class="track" role="list">
          {copies.map((copy) =>
            entries.map(({ p, href, track, authors }) => (
              <li class:list={['row', { 'row--clone': copy === 1 }]} aria-hidden={copy === 1 ? 'true' : undefined}>
                <a class="item" href={href} rel={isExternal(href) ? 'noopener' : undefined} tabindex={copy === 1 ? -1 : undefined}>
                  <span class="meta">
                    <span class="tag tag--venue">
                      {p.venue} {p.year}
                    </span>
                    {track && <span class="tag">{track}</span>}
                    {p.isNew && <span class="tag tag--new">New</span>}
                    <Icon name="arrow-up-right" class="go" />
                  </span>
                  <span class="paper-title">{p.title}</span>
                  <span class="authors">
                    {authors.shown.map((a, i) => (
                      <>
                        {i > 0 && (authors.skipped && i === authors.shown.length - 1 ? ', …, ' : ', ')}
                        <span class:list={{ me: a.isOwner }}>{a.name}</span>
                      </>
                    ))}
                    {authors.more && <span class="etal"> et al.</span>}
                  </span>
                </a>
              </li>
            )),
          )}
        </ul>
      </div>
    </section>
  )
}

<style>
  @layer components {
    .recent {
      position: relative;
      display: flex;
      flex-direction: column;
      border-radius: var(--r-l);
      background: var(--glass);
      border: 1px solid var(--glass-border);
      box-shadow:
        var(--shadow-3),
        inset 0 1px 0 var(--glass-edge);
      -webkit-backdrop-filter: blur(20px) saturate(1.6);
      backdrop-filter: blur(20px) saturate(1.6);
      overflow: hidden;
    }
    .head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1rem 0.6rem 1.1rem;
      border-bottom: 1px solid var(--line);
    }
    .title {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-family: var(--ff-mono);
      font-size: var(--step--1);
      font-weight: 450;
      letter-spacing: 0.02em;
      color: var(--ink-2);
    }
    .live {
      position: relative;
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 50%;
      background: var(--accent);
    }
    .all {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: var(--step--1);
      font-weight: 550;
      color: var(--ink-2);
      text-decoration: none;
    }
    .all:hover {
      color: var(--accent);
    }

    /* Fixed height: the panel never changes size, whatever the titles do. */
    .viewport {
      block-size: 19rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      -webkit-mask-image: linear-gradient(to bottom, #000 85%, transparent);
      mask-image: linear-gradient(to bottom, #000 85%, transparent);
    }
    @media (min-width: 64rem) {
      .viewport {
        block-size: 20.5rem;
      }
    }
    .track {
      display: flex;
      flex-direction: column;
      padding: 0.35rem;
    }
    .row--clone {
      display: none;
    }
    .item {
      display: grid;
      gap: 0.35rem;
      padding: 0.8rem 0.8rem 0.85rem;
      border-radius: var(--r-m);
      text-decoration: none;
      color: var(--ink);
      transition: background-color var(--dur-1) ease;
    }
    .row + .row .item {
      box-shadow: 0 -1px 0 var(--line);
    }
    .item:hover {
      color: var(--ink);
      background: color-mix(in oklch, var(--bg-raised) 85%, transparent);
    }
    .item:focus-visible {
      outline-offset: -2px;
    }
    .meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.3rem;
    }
    .item :global(.go) {
      margin-inline-start: auto;
      color: var(--accent);
      opacity: 0;
      translate: -4px 4px;
      transition:
        opacity var(--dur-1) ease,
        translate var(--dur-2) var(--ease-spring);
    }
    .item:hover :global(.go),
    .item:focus-visible :global(.go) {
      opacity: 1;
      translate: 0 0;
    }
    .paper-title {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
      font-family: var(--ff-display);
      font-size: var(--step-0);
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: -0.005em;
      text-wrap: pretty;
    }
    .authors {
      font-size: var(--step--2);
      color: var(--ink-2);
      line-height: 1.5;
    }
    .authors .me {
      text-decoration-thickness: 1.5px;
    }
    .etal {
      font-style: italic;
    }

    @media (prefers-reduced-motion: no-preference) {
      .live::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--accent);
        animation: ping 2.4s var(--ease-out) infinite;
      }
      /* Seamless loop: two identical halves (rows carry their own spacing, so
         the halves are exactly equal) translated by -50%. */
      .recent--loop .viewport {
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
        mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
      }
      .recent--loop .row--clone {
        display: block;
      }
      .recent--loop .track {
        padding-block: 0;
        animation: ticker calc(var(--ticker-items) * 5s) linear infinite;
        will-change: transform;
      }
      .recent--loop:hover .track,
      .recent--loop:focus-within .track {
        animation-play-state: paused;
      }
      /* Keyboard users get the real, scrollable list so focus never lands off-screen. */
      .recent--loop:has(:focus-visible) .viewport {
        overflow-y: auto;
      }
      .recent--loop:has(:focus-visible) .track {
        animation: none;
      }
      .recent--loop:has(:focus-visible) .row--clone {
        display: none;
      }
    }
    @keyframes ticker {
      to {
        transform: translateY(-50%);
      }
    }
    @keyframes ping {
      70%,
      100% {
        transform: scale(3);
        opacity: 0;
      }
    }
  }
</style>
