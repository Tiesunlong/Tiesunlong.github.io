---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import RecentTicker from './RecentTicker.astro';
import SocialLinks from './SocialLinks.astro';
import { currentPositions, photoAlt, profile } from '../lib/data';
import { resolvePhoto } from '../lib/photo';

const photo = resolvePhoto(profile.photo);
const roles = [...new Set(currentPositions.map((p) => p.title))];

// Split the name into words of glyphs for the staggered, variable-axis entrance.
let glyphIndex = 0;
const words = profile.name
  .split(/\s+/)
  .filter(Boolean)
  .map((w) => [...w].map((ch) => ({ ch, i: glyphIndex++ })));

// The headline may already name the roles and orgs ("Research Fellow, Duke-NUS
// & NTU"); don't say the same thing three times in the kicker and the chips.
const headline = profile.headline.toLowerCase();
const initials = (org: string) =>
  org
    .split(/[\s-]+/)
    .filter((w) => /^[A-Z]/.test(w))
    .map((w) => w[0])
    .join('');
const named = (org: string) =>
  headline.includes(org.toLowerCase()) || (initials(org).length > 1 && new RegExp(`\\b${initials(org)}\\b`).test(profile.headline));
const showPositions = !currentPositions.every((p) => named(p.org));
const showRoles = !roles.every((r) => headline.includes(r.toLowerCase()));
// Titles are in the kicker; repeat them per org only when they differ.
const showTitles = roles.length > 1;
const kicker = showRoles || profile.location;
---

<section class="hero container" aria-labelledby="hero-name">
  <div class="copy">
    {
      kicker && (
        <p class="eyebrow kicker rise" style="--i: 0">
          <span class="pulse" aria-hidden="true" />
          {showRoles && <span>{roles.join(' / ')}</span>}
          {profile.location && (
            <span class:list={['loc', { 'loc--sep': showRoles }]}>
              <Icon name="map-pin" />
              {profile.location}
            </span>
          )}
        </p>
      )
    }

    <h1 id="hero-name" class="name">
      <span class="sr-only">{profile.name}</span>
      <span class="glyphs" aria-hidden="true">
        {
          words.map((word, wi) => (
            <>
              <span class="word">
                {word.map(({ ch, i }) => (
                  <span class="ch" style={`--i: ${i}`}>
                    {ch}
                  </span>
                ))}
              </span>
              {wi < words.length - 1 && ' '}
            </>
          ))
        }
      </span>
    </h1>
    {profile.nameNative && <p class="native rise" lang="zh-CN" style="--i: 2">{profile.nameNative}</p>}

    <p class="headline rise" style="--i: 3">{profile.headline}</p>

    {
      showPositions && (
        <ul class="positions rise" role="list" style="--i: 4" aria-label="Current positions">
          {currentPositions.map((p) => (
            <li>
              {showTitles && <span class="pos-title">{p.title}</span>}
              {p.url ? (
                <a href={p.url} rel="noopener">
                  {p.org}
                </a>
              ) : (
                <span>{p.org}</span>
              )}
            </li>
          ))}
        </ul>
      )
    }

    <div class="cta rise" style="--i: 5">
      <SocialLinks variant="hero" />
      <a class="btn btn--ghost" href="/publications/">
        <Icon name="books" />
        Publications
      </a>
      <a class="btn btn--ghost" href="/cv/">
        <Icon name="read-cv" />
        CV
      </a>
    </div>
  </div>

  <div class="aside">
    <figure class="portrait rise" style="--i: 2">
      <div class="frame spotlight">
        {
          photo.kind === 'asset' ? (
            <Picture
              src={photo.src}
              alt={photoAlt}
              formats={['avif', 'webp']}
              widths={[160, 320, 480, 640]}
              sizes="(min-width: 64rem) 17rem, (min-width: 48rem) 14rem, 4.25rem"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="photo"
            />
          ) : (
            <img src={photo.src} alt={photoAlt} width="640" height="640" class="photo" loading="eager" decoding="async" />
          )
        }
      </div>
    </figure>
    <div class="ticker rise" style="--i: 6">
      <RecentTicker />
    </div>
  </div>
</section>

<style>
  @layer components {
    .hero {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1rem;
      row-gap: 1.25rem;
      align-items: center;
      padding-block: clamp(2.5rem, 1rem + 6vw, 6rem) clamp(0.5rem, 1vw, 1.5rem);
    }
    /* Mobile: copy children join the grid so the small portrait sits beside the kicker. */
    .copy {
      display: contents;
    }
    .copy > :not(.kicker) {
      grid-column: 1 / -1;
    }
    .aside {
      display: contents;
    }
    .portrait {
      grid-row: 1;
      grid-column: 1;
      width: 4.25rem;
    }
    .kicker {
      grid-row: 1;
      grid-column: 2;
    }
    /* Mobile: the ticker stacks below the hero text. */
    .ticker {
      grid-column: 1 / -1;
      margin-top: 0.75rem;
    }

    @media (min-width: 48rem) {
      .hero {
        grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
        column-gap: clamp(2rem, 5vw, 5rem);
        min-height: min(42rem, calc(100dvh - 7rem));
      }
      .copy {
        display: grid;
        gap: 1.4rem;
        grid-column: 1;
        grid-row: 1;
        align-content: center;
      }
      .copy > *,
      .copy > :not(.kicker) {
        grid-column: auto;
        grid-row: auto;
      }
      /* Portrait top-right, the glass ticker overlapping its lower edge. */
      .aside {
        display: grid;
        grid-column: 2;
        grid-row: 1;
        align-content: center;
        justify-items: end;
      }
      .portrait {
        grid-row: auto;
        grid-column: auto;
        width: min(100%, 14rem);
        /* leaves room for the offset plate behind the photo */
        margin-inline-end: 1.25rem;
      }
      .ticker {
        grid-column: auto;
        width: 100%;
        margin-top: -3.5rem;
        position: relative;
        z-index: 1;
      }
    }
    @media (min-width: 64rem) {
      .portrait {
        width: 17rem;
      }
      .ticker {
        margin-top: -4.5rem;
      }
    }

    .kicker {
      flex-wrap: wrap;
      row-gap: 0.25rem;
      color: var(--ink-2);
    }
    .pulse {
      position: relative;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: var(--accent);
      flex: none;
    }
    .pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--accent);
      animation: ping 2.4s var(--ease-out) infinite;
    }
    @keyframes ping {
      70%,
      100% {
        transform: scale(3);
        opacity: 0;
      }
    }
    .loc {
      display: inline-flex;
      align-items: center;
      gap: 0.3em;
    }
    .loc--sep {
      padding-inline-start: 0.6em;
      border-inline-start: 1px solid var(--line-strong);
    }

    /* ── Kinetic name ── */
    .name {
      font-size: var(--step-4);
      font-weight: 430;
      line-height: 0.98;
      letter-spacing: -0.035em;
      font-variation-settings: 'SOFT' 0, 'WONK' 0;
    }
    .word {
      display: inline-block;
      white-space: nowrap;
    }
    .ch {
      display: inline-block;
      font-variation-settings: 'SOFT' var(--soft, 0), 'WONK' 0;
      transition:
        --soft 500ms var(--ease-out),
        translate 500ms var(--ease-spring),
        color 300ms ease;
    }
    @media (prefers-reduced-motion: no-preference) {
      .ch {
        animation: glyph-in 1100ms var(--ease-out) backwards;
        animation-delay: calc(var(--i) * 42ms + 120ms);
      }
      /* Pointer proximity: the hovered glyph swells, its neighbours follow at half strength. */
      @media (hover: hover) {
        .ch:hover {
          --soft: 100;
          translate: 0 -0.07em;
          color: var(--accent);
        }
        .ch:hover + .ch,
        .ch:has(+ .ch:hover) {
          --soft: 55;
          translate: 0 -0.03em;
        }
      }
    }
    @keyframes glyph-in {
      from {
        opacity: 0;
        transform: translateY(0.4em) rotate(5deg);
        filter: blur(10px);
        --soft: 100;
      }
      60% {
        filter: blur(0);
      }
      to {
        opacity: 1;
        transform: none;
        --soft: 0;
      }
    }

    .native {
      font-family: var(--ff-cjk);
      font-weight: 500;
      font-size: var(--step-2);
      color: var(--ink-2);
      letter-spacing: 0.08em;
    }
    .headline {
      max-width: 34ch;
      font-family: var(--ff-display);
      font-size: var(--step-2);
      font-weight: 380;
      line-height: 1.35;
      letter-spacing: -0.012em;
      color: var(--ink);
      text-wrap: balance;
    }
    .positions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .positions li {
      display: inline-flex;
      align-items: baseline;
      gap: 0.5em;
      padding: 0.4rem 0.8rem;
      border-radius: var(--r-m);
      border: 1px solid var(--line);
      background: color-mix(in oklch, var(--bg-raised) 65%, transparent);
      font-size: var(--step--1);
    }
    .pos-title {
      font-family: var(--ff-mono);
      font-size: var(--step--2);
      color: var(--ink-2);
    }
    .positions a,
    .positions li > span:last-child {
      font-weight: 560;
      color: var(--ink);
      text-decoration: none;
    }
    .positions a:hover {
      color: var(--accent);
    }
    .cta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.4rem;
    }

    /* ── Portrait ── */
    .portrait {
      position: relative;
      isolation: isolate;
    }
    .frame {
      position: relative;
      aspect-ratio: 1;
      border-radius: 28%;
      overflow: hidden;
      background: var(--bg-sunken);
      box-shadow:
        0 0 0 1px var(--glass-border),
        var(--shadow-2);
    }
    .frame :global(.photo) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    @media (min-width: 48rem) {
      .frame {
        border-radius: var(--r-xl);
        box-shadow:
          0 0 0 1px var(--glass-border),
          var(--shadow-3);
        rotate: 1.5deg;
        transition: rotate var(--dur-3) var(--ease-spring);
      }
      .portrait:hover .frame {
        rotate: 0deg;
      }
      /* Offset seal-coloured plate behind the photo */
      .portrait::before {
        content: '';
        position: absolute;
        inset: 1.25rem -1.25rem -1.25rem 1.25rem;
        border-radius: var(--r-xl);
        border: 1px solid color-mix(in oklch, var(--accent) 45%, transparent);
        background: repeating-linear-gradient(
          -45deg,
          transparent 0 9px,
          color-mix(in oklch, var(--accent) 12%, transparent) 9px 10px
        );
        z-index: -1;
      }
    }
  }

  /* Registered so the SOFT axis interpolates smoothly instead of flipping. */
  @property --soft {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
</style>
