---
import Icon, { type IconName } from './Icon.astro';
import type { NewsItem } from '../lib/schema';
import { formatDate } from '../lib/format';
import { renderInline } from '../lib/markdown';

interface Props {
  items: NewsItem[];
  /** Items shown before the "earlier" disclosure. */
  visible?: number | undefined;
}
const { items, visible = 6 } = Astro.props;

const ICON: Record<NewsItem['kind'], IconName> = {
  paper: 'article',
  award: 'trophy',
  talk: 'microphone',
  service: 'hand-heart',
  position: 'briefcase',
  other: 'megaphone',
};
const LABEL: Record<NewsItem['kind'], string> = {
  paper: 'Paper',
  award: 'Award',
  talk: 'Talk',
  service: 'Service',
  position: 'Position',
  other: 'Update',
};
const head = items.slice(0, visible);
const rest = items.slice(visible);
---

{
  items.length === 0 ? (
    <p class="empty">No news yet.</p>
  ) : (
    <>
      <ol class="news" role="list">
        {head.map((n) => (
          <li class="item reveal">
            <time datetime={n.date} class="date mono">
              {formatDate(n.date)}
            </time>
            <span class="kind" title={LABEL[n.kind]}>
              <Icon name={ICON[n.kind]} label={LABEL[n.kind]} />
            </span>
            <p class="text" set:html={renderInline(n.text)} />
          </li>
        ))}
      </ol>
      {rest.length > 0 && (
        <details class="earlier">
          <summary>
            <span>Show {rest.length} earlier</span>
          </summary>
          <ol class="news" role="list">
            {rest.map((n) => (
              <li class="item">
                <time datetime={n.date} class="date mono">
                  {formatDate(n.date)}
                </time>
                <span class="kind" title={LABEL[n.kind]}>
                  <Icon name={ICON[n.kind]} label={LABEL[n.kind]} />
                </span>
                <p class="text" set:html={renderInline(n.text)} />
              </li>
            ))}
          </ol>
        </details>
      )}
    </>
  )
}

<style>
  @layer components {
    .news {
      position: relative;
      display: grid;
    }
    .item {
      position: relative;
      display: grid;
      grid-template-columns: 5.5rem auto minmax(0, 1fr);
      align-items: start;
      gap: 0.25rem 1rem;
      padding-block: 1rem;
      border-top: 1px solid var(--line);
    }
    .date {
      padding-top: 0.2rem;
      font-size: var(--step--1);
      color: var(--ink-2);
      white-space: nowrap;
    }
    .kind {
      display: grid;
      place-items: center;
      width: 1.9rem;
      height: 1.9rem;
      border-radius: var(--r-s);
      border: 1px solid var(--line);
      background: var(--bg-raised);
      color: var(--accent);
    }
    .text {
      max-width: 65ch;
      padding-top: 0.1rem;
    }
    .text :global(strong) {
      font-weight: 620;
    }
    @media (max-width: 30rem) {
      .item {
        grid-template-columns: auto minmax(0, 1fr);
      }
      .date {
        grid-column: 1 / -1;
      }
    }
    .earlier summary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
      padding: 0.45rem 0.9rem;
      border-radius: 999px;
      border: 1px solid var(--line-strong);
      font-size: var(--step--1);
      font-weight: 550;
      color: var(--ink-2);
      cursor: pointer;
      list-style: none;
    }
    .earlier summary::-webkit-details-marker {
      display: none;
    }
    .earlier summary::before {
      content: '+';
      font-family: var(--ff-mono);
      color: var(--accent);
    }
    .earlier[open] summary::before {
      content: '−';
    }
    .earlier[open] summary {
      margin-bottom: 0.5rem;
    }
    .empty {
      color: var(--ink-2);
    }
  }
</style>
