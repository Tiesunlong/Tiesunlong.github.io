---
import { getImage } from 'astro:assets';
import { photoAlt, profile } from '../lib/data';
import { resolvePhoto } from '../lib/photo';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'profile' | undefined;
  jsonLd?: Record<string, unknown> | undefined;
  /** Error pages: no canonical, kept out of search results. */
  noindex?: boolean | undefined;
}

const { title, description, ogType = 'website', jsonLd, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://tiesunlong.github.io');
const canonical = new URL(Astro.url.pathname, site).href;

const photo = resolvePhoto(profile.photo);
// Social cards need a plain JPEG; only local assets can be resized.
const ogImage =
  photo.kind === 'asset'
    ? await getImage({ src: photo.src, width: 600, height: 600, format: 'jpg', quality: 82 })
    : undefined;
const ogImageUrl = new URL(ogImage?.src ?? (photo.kind === 'public' ? photo.src : '/favicon.svg'), site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="author" content={profile.name} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
{ogImage && <meta property="og:image:width" content="600" />}
{ogImage && <meta property="og:image:height" content="600" />}
<meta property="og:image:alt" content={photoAlt} />
<meta property="og:locale" content="en_US" />
{ogType === 'profile' && <meta property="profile:first_name" content={profile.name.split(' ')[0]} />}
{ogType === 'profile' && <meta property="profile:last_name" content={profile.name.split(' ').slice(1).join(' ')} />}

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
