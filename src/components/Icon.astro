---
/**
 * Phosphor (regular) icons inlined at build time — no icon font, no runtime JS.
 * Add an icon by importing it below and adding it to `icons`.
 */
import arrowLeft from '@phosphor-icons/core/regular/arrow-left.svg?raw';
import arrowRight from '@phosphor-icons/core/regular/arrow-right.svg?raw';
import arrowUpRight from '@phosphor-icons/core/regular/arrow-up-right.svg?raw';
import article from '@phosphor-icons/core/regular/article.svg?raw';
import books from '@phosphor-icons/core/regular/books.svg?raw';
import briefcase from '@phosphor-icons/core/regular/briefcase.svg?raw';
import check from '@phosphor-icons/core/regular/check.svg?raw';
import code from '@phosphor-icons/core/regular/code.svg?raw';
import copy from '@phosphor-icons/core/regular/copy.svg?raw';
import database from '@phosphor-icons/core/regular/database.svg?raw';
import downloadSimple from '@phosphor-icons/core/regular/download-simple.svg?raw';
import enter from '@phosphor-icons/core/regular/arrow-elbow-down-left.svg?raw';
import envelope from '@phosphor-icons/core/regular/envelope-simple.svg?raw';
import filePdf from '@phosphor-icons/core/regular/file-pdf.svg?raw';
import fileText from '@phosphor-icons/core/regular/file-text.svg?raw';
import github from '@phosphor-icons/core/regular/github-logo.svg?raw';
import graduationCap from '@phosphor-icons/core/regular/graduation-cap.svg?raw';
import handHeart from '@phosphor-icons/core/regular/hand-heart.svg?raw';
import identification from '@phosphor-icons/core/regular/identification-badge.svg?raw';
import linkSimple from '@phosphor-icons/core/regular/link-simple.svg?raw';
import linkedin from '@phosphor-icons/core/regular/linkedin-logo.svg?raw';
import list from '@phosphor-icons/core/regular/list.svg?raw';
import magnifyingGlass from '@phosphor-icons/core/regular/magnifying-glass.svg?raw';
import mapPin from '@phosphor-icons/core/regular/map-pin.svg?raw';
import medal from '@phosphor-icons/core/regular/medal.svg?raw';
import megaphone from '@phosphor-icons/core/regular/megaphone-simple.svg?raw';
import microphone from '@phosphor-icons/core/regular/microphone-stage.svg?raw';
import monitor from '@phosphor-icons/core/regular/monitor.svg?raw';
import moon from '@phosphor-icons/core/regular/moon.svg?raw';
import newspaper from '@phosphor-icons/core/regular/newspaper.svg?raw';
import printer from '@phosphor-icons/core/regular/printer.svg?raw';
import quotes from '@phosphor-icons/core/regular/quotes.svg?raw';
import readCv from '@phosphor-icons/core/regular/read-cv-logo.svg?raw';
import sparkle from '@phosphor-icons/core/regular/sparkle.svg?raw';
import sun from '@phosphor-icons/core/regular/sun.svg?raw';
import trophy from '@phosphor-icons/core/regular/trophy.svg?raw';
import x from '@phosphor-icons/core/regular/x.svg?raw';
import xLogo from '@phosphor-icons/core/regular/x-logo.svg?raw';

const icons = {
  'arrow-left': arrowLeft,
  'arrow-right': arrowRight,
  'arrow-up-right': arrowUpRight,
  article,
  books,
  briefcase,
  check,
  code,
  copy,
  database,
  download: downloadSimple,
  enter,
  envelope,
  'file-pdf': filePdf,
  'file-text': fileText,
  github,
  'graduation-cap': graduationCap,
  'hand-heart': handHeart,
  identification,
  link: linkSimple,
  linkedin,
  list,
  search: magnifyingGlass,
  'map-pin': mapPin,
  medal,
  megaphone,
  microphone,
  monitor,
  moon,
  newspaper,
  printer,
  quotes,
  'read-cv': readCv,
  sparkle,
  sun,
  trophy,
  x,
  'x-logo': xLogo,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number | string | undefined;
  /** Accessible label; omit for decorative icons. */
  label?: string | undefined;
  class?: string | undefined;
}

const { name, size = '1em', label, class: className } = Astro.props;
const inner = icons[name].replace(/^<svg[^>]*>|<\/svg>\s*$/g, '');
---

<svg
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  class:list={['icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
/>
