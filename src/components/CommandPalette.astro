---
/**
 * ⌘K / Ctrl+K palette. Every entry is rendered here at build time; the script in
 * scripts/palette.ts only filters, moves the active option and runs the choice.
 */
import Icon, { type IconName } from './Icon.astro';
import { NAV } from '../lib/nav';
import { profile, publications } from '../lib/data';

interface Item {
  id: string;
  label: string;
  hint?: string | undefined;
  icon: IconName;
  href?: string | undefined;
  action?: string | undefined;
  keywords?: string | undefined;
}

const groups: Array<{ title: string; items: Item[] }> = [
  {
    title: 'Pages',
    items: NAV.map((n) => ({ id: `page${n.href.replaceAll('/', '-')}`, label: n.label, hint: n.description, icon: n.icon, href: n.href })),
  },
  {
    title: 'Sections',
    items: [
      { id: 'sec-glance', label: 'At a glance', hint: 'Home', icon: 'sparkle', href: '/#glance' },
      { id: 'sec-about', label: 'Biography', hint: 'Home', icon: 'identification', href: '/#about' },
      { id: 'sec-selected', label: 'Selected publications', hint: 'Home', icon: 'books', href: '/#selected' },
      { id: 'sec-news', label: 'News', hint: 'Home', icon: 'newspaper', href: '/#news' },
    ],
  },
  {
    title: 'Publications',
    items: publications.map((p) => ({
      id: `paper-${p.id}`,
      label: p.title,
      hint: `${p.venue} ${p.year}`,
      icon: 'article' as const,
      href: `/publications/#${p.id}`,
      keywords: p.authors.join(' '),
    })),
  },
  {
    title: 'Links & actions',
    items: [
      ...profile.links.map((l) => ({ id: `link-${l.kind}-${l.label}`.replace(/\W+/g, '-'), label: l.label, hint: 'Open link', icon: 'arrow-up-right' as const, href: l.url })),
      ...(profile.email
        ? [{ id: 'act-email', label: 'Copy email address', hint: profile.email, icon: 'envelope' as const, action: `copy:${profile.email}` }]
        : []),
      { id: 'act-bib', label: 'Download all BibTeX', hint: 'publications.bib', icon: 'download', href: '/publications.bib' },
      { id: 'act-light', label: 'Light theme', icon: 'sun', action: 'theme:light', keywords: 'appearance mode' },
      { id: 'act-dark', label: 'Dark theme', icon: 'moon', action: 'theme:dark', keywords: 'appearance mode' },
      { id: 'act-system', label: 'System theme', icon: 'monitor', action: 'theme:system', keywords: 'appearance mode auto' },
    ],
  },
];
---

<dialog class="palette" id="palette" aria-label="Search the site">
  <div class="field">
    <Icon name="search" class="field__icon" />
    <input
      id="palette-input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      aria-label="Search pages, sections and papers"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search pages, sections, papers…"
    />
    <kbd>Esc</kbd>
  </div>

  <ul id="palette-list" class="list" role="listbox" aria-label="Results">
    {
      groups.map((g, gi) => (
        <li role="presentation" class="group" data-group={gi}>
          <p class="group__title" id={`palette-g${gi}`} aria-hidden="true">
            {g.title}
          </p>
          <ul role="group" aria-labelledby={`palette-g${gi}`}>
            {g.items.map((item) => (
              <li
                role="option"
                id={`pal-${item.id}`}
                class="option"
                aria-selected="false"
                data-href={item.href}
                data-action={item.action}
                data-text={[item.label, item.hint, item.keywords].filter(Boolean).join(' ').toLowerCase()}
              >
                <span class="option__icon">
                  <Icon name={item.icon} />
                </span>
                <span class="option__label">{item.label}</span>
                {item.hint && <span class="option__hint">{item.hint}</span>}
                <Icon name="enter" class="option__enter" />
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
  <p class="empty" hidden>No results. Try a venue, a co-author or a year.</p>

  <footer class="foot" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
    <span><kbd>↵</kbd> open</span>
    <span><kbd>esc</kbd> close</span>
  </footer>
</dialog>

<style>
  @layer components {
    .palette {
      width: min(40rem, calc(100vw - 2rem));
      max-height: min(36rem, calc(100dvh - 6rem));
      margin: 12dvh auto auto;
      padding: 0;
      border-radius: var(--r-l);
      border: 1px solid var(--glass-border);
      background: var(--glass-strong);
      color: var(--ink);
      box-shadow:
        var(--shadow-3),
        inset 0 1px 0 var(--glass-edge);
      -webkit-backdrop-filter: blur(28px) saturate(1.7);
      backdrop-filter: blur(28px) saturate(1.7);
      overflow: hidden;
      flex-direction: column;
      transition:
        opacity var(--dur-2) ease,
        scale var(--dur-2) var(--ease-spring),
        display var(--dur-2) allow-discrete,
        overlay var(--dur-2) allow-discrete;
      opacity: 0;
      scale: 0.97;
    }
    .palette[open] {
      display: flex;
      opacity: 1;
      scale: 1;
    }
    @starting-style {
      .palette[open] {
        opacity: 0;
        scale: 0.97;
      }
    }
    .palette::backdrop {
      background: color-mix(in oklch, var(--bg-sunken) 45%, transparent);
      -webkit-backdrop-filter: blur(3px);
      backdrop-filter: blur(3px);
    }
    .field {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.9rem 1.1rem;
      border-bottom: 1px solid var(--line);
    }
    .field :global(.field__icon) {
      font-size: 1.2rem;
      color: var(--ink-2);
      flex: none;
    }
    .field input {
      flex: 1;
      min-width: 0;
      border: 0;
      background: none;
      font-size: var(--step-1);
      outline: none;
    }
    .field input::placeholder {
      color: var(--ink-2);
    }
    .field:focus-within {
      box-shadow: inset 0 -2px 0 var(--accent);
    }
    .list {
      list-style: none;
      padding: 0.4rem;
      margin: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      flex: 1;
    }
    .list ul {
      list-style: none;
      padding: 0;
    }
    .group + .group {
      margin-top: 0.35rem;
    }
    .group__title {
      padding: 0.5rem 0.75rem 0.3rem;
      font-family: var(--ff-mono);
      font-size: var(--step--2);
      color: var(--ink-2);
    }
    .option {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 0.75rem;
      padding: 0.55rem 0.75rem;
      border-radius: var(--r-m);
      cursor: pointer;
      scroll-margin-block: 0.5rem;
    }
    .option__icon {
      display: grid;
      place-items: center;
      width: 1.9rem;
      height: 1.9rem;
      border-radius: var(--r-s);
      border: 1px solid var(--line);
      background: var(--bg-raised);
      color: var(--ink-2);
    }
    .option__label {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: var(--step--1);
      font-weight: 520;
    }
    .option__hint {
      max-width: 14rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: var(--step--2);
      font-family: var(--ff-mono);
      color: var(--ink-2);
    }
    .option :global(.option__enter) {
      color: var(--accent);
      opacity: 0;
    }
    .option[aria-selected='true'] {
      background: var(--accent-soft);
    }
    .option[aria-selected='true'] .option__icon {
      color: var(--accent-on-soft);
      border-color: color-mix(in oklch, var(--accent) 35%, transparent);
    }
    .option[aria-selected='true'] :global(.option__enter) {
      opacity: 1;
    }
    .option[aria-selected='true'] .option__hint {
      color: var(--accent-on-soft);
    }
    @media (max-width: 30rem) {
      .option__hint {
        display: none;
      }
    }
    .empty {
      padding: 2rem 1rem;
      text-align: center;
      color: var(--ink-2);
      font-size: var(--step--1);
    }
    .foot {
      display: flex;
      gap: 1.25rem;
      padding: 0.6rem 1.1rem;
      border-top: 1px solid var(--line);
      font-size: var(--step--2);
      color: var(--ink-2);
    }
    .foot kbd {
      margin-inline-end: 0.2rem;
    }
    @media (pointer: coarse) {
      .foot {
        display: none;
      }
    }
  }
</style>
