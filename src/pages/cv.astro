---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import { awards, experience, groupByYear, peerReviewed, preprints, profile, publications, services } from '../lib/data';
import type { Experience } from '../lib/schema';
import { graph, personLd } from '../lib/jsonld';
import { renderInline } from '../lib/markdown';

const positions = experience.filter((e) => e.kind === 'position');
const education = experience.filter((e) => e.kind === 'education');
const pdf = profile.links.find((l) => l.kind === 'cv');
// Continuous numbering across year groups, newest first; preprints last.
const pubGroups = (() => {
  let n = 0;
  const groups = [
    ...groupByYear(peerReviewed).map(([year, items]) => ({ label: String(year), items })),
    ...(preprints.length ? [{ label: 'Preprints', items: preprints }] : []),
  ];
  return groups.map((g) => ({ ...g, start: (n += g.items.length) - g.items.length + 1 }));
})();
const sections: Array<{ id: string; title: string; items: Experience[] }> = [
  { id: 'positions', title: 'Positions', items: positions },
  { id: 'education', title: 'Education', items: education },
].filter((s) => s.items.length > 0);
---

<Base
  title="CV"
  description={`Curriculum vitae of ${profile.name}: positions, education, publications, awards and service.`}
  jsonLd={graph(personLd())}
>
  <PageHead eyebrow={profile.name} title="Curriculum vitae" lede={profile.headline}>
    <button class="btn btn--primary needs-js no-print" type="button" data-print>
      <Icon name="printer" />
      Print or save as PDF
    </button>
    {
      pdf && (
        <a class="btn no-print" href={pdf.url}>
          <Icon name="download" />
          {pdf.label}
        </a>
      )
    }
  </PageHead>

  <div class="container cv">
    {
      sections.map((s) => (
        <section class="block reveal" aria-labelledby={`cv-${s.id}`}>
          <h2 id={`cv-${s.id}`}>{s.title}</h2>
          <ol class="timeline" role="list">
            {s.items.map((e) => (
              <li class="entry">
                <p class="entry__period mono">{e.period}</p>
                <div>
                  <h3 class="entry__title">{e.title}</h3>
                  <p class="entry__org">
                    {e.url ? (
                      <a href={e.url} rel="noopener">
                        {e.org}
                      </a>
                    ) : (
                      e.org
                    )}
                    {e.location && <span class="muted"> · {e.location}</span>}
                  </p>
                  {e.note && <p class="entry__note" set:html={renderInline(e.note)} />}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    {
      profile.interests.length > 0 && (
        <section class="block reveal" aria-labelledby="cv-interests">
          <h2 id="cv-interests">Research interests</h2>
          <ul class="chips" role="list">
            {profile.interests.map((i) => (
              <li class="chip">{i}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      publications.length > 0 && (
        <section class="block" aria-labelledby="cv-pubs">
          <h2 id="cv-pubs">
            Publications <a class="see-all no-print" href="/publications/">Full list</a>
          </h2>
          <div class="pubs">
            {pubGroups.map(({ label, items, start }) => (
              <div class="pub-year">
                <p class="pub-year__label mono">{label}</p>
                <ol class="refs" start={start}>
                  {items.map((p) => (
                    <li>
                      {p.authorList.map((a, i) => (
                        <>
                          {a.etAl ? <em>et al.</em> : <span class:list={{ me: a.isOwner }}>{a.name}</span>}
                          {a.equal && <sup class="mark">*</sup>}
                          {a.corresponding && <sup class="mark">†</sup>}
                          {i < p.authorList.length - 1 && (p.authorList[i + 1]?.etAl ? ' ' : ', ')}
                        </>
                      ))}
                      {p.authorList.at(-1)?.etAl ? ' ' : '. '}
                      <a href={`/publications/#${p.id}`} class="ref-title">{p.title}</a>. <em>{p.venueFull ?? p.venue}</em>, {p.year}
                      {p.status === 'accepted' && <span class="tag tag--status">accepted</span>}
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      awards.length > 0 && (
        <section class="block reveal" aria-labelledby="cv-awards">
          <h2 id="cv-awards">Awards</h2>
          <ol class="timeline" role="list">
            {awards.map((a) => (
              <li class="entry">
                <p class="entry__period mono">{a.year}</p>
                <div>
                  <h3 class="entry__title">{a.title}</h3>
                  {a.issuer && <p class="entry__org">{a.issuer}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      services.length > 0 && (
        <section class="block reveal" aria-labelledby="cv-services">
          <h2 id="cv-services">Service</h2>
          <dl class="services">
            {services.map((s) => (
              <div>
                <dt>{s.role}</dt>
                <dd>{s.venues.join(', ')}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </div>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  @layer components {
    .cv {
      display: grid;
    }
    .block {
      display: grid;
      gap: 1rem 3rem;
      padding-block: 2rem;
      border-top: 1px solid var(--line);
    }
    @media (min-width: 60rem) {
      .block {
        grid-template-columns: 12rem minmax(0, 1fr);
      }
    }
    .block > h2 {
      font-size: var(--step-1);
      font-weight: 540;
      letter-spacing: -0.01em;
    }
    .see-all {
      display: block;
      margin-top: 0.4rem;
      font-family: var(--ff-sans);
      font-size: var(--step--1);
      font-weight: 500;
      color: var(--ink-2);
    }
    .timeline {
      display: grid;
      gap: 1.25rem;
    }
    .entry {
      display: grid;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 0.25rem 1.25rem;
    }
    @media (max-width: 30rem) {
      .entry {
        grid-template-columns: 1fr;
      }
    }
    .entry__period {
      font-size: var(--step--1);
      color: var(--ink-2);
      padding-top: 0.15rem;
    }
    .entry__title {
      font-family: var(--ff-sans);
      font-size: var(--step-0);
      font-weight: 620;
      letter-spacing: 0;
    }
    .entry__org {
      color: var(--ink-2);
    }
    .entry__org a {
      color: var(--ink);
    }
    .entry__note {
      margin-top: 0.35rem;
      font-size: var(--step--1);
      color: var(--ink-2);
      max-width: 65ch;
    }
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .pubs {
      display: grid;
      gap: 1.25rem;
    }
    .pub-year {
      display: grid;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 0.25rem 1.25rem;
    }
    @media (max-width: 30rem) {
      .pub-year {
        grid-template-columns: 1fr;
      }
    }
    .pub-year__label {
      font-size: var(--step--1);
      color: var(--ink-2);
    }
    .refs {
      display: grid;
      gap: 0.75rem;
      padding-left: 1.2rem;
      font-size: var(--step--1);
      color: var(--ink-2);
      line-height: 1.6;
    }
    .refs li::marker {
      color: var(--ink-3);
      font-family: var(--ff-mono);
      font-size: 0.85em;
    }
    .ref-title {
      color: var(--ink);
      text-decoration: none;
      font-weight: 520;
    }
    .ref-title:hover {
      color: var(--accent);
    }
    .refs .tag {
      margin-inline-start: 0.4rem;
      vertical-align: 0.1em;
    }
    .services {
      display: grid;
      gap: 0.9rem;
    }
    .services dt {
      font-weight: 620;
    }
    .services dd {
      color: var(--ink-2);
      font-size: var(--step--1);
      max-width: 75ch;
    }

    @media print {
      .block {
        grid-template-columns: 9rem minmax(0, 1fr);
        padding-block: 0.9rem;
        break-inside: avoid;
      }
      .pubs {
        break-inside: auto;
      }
    }
  }
</style>
