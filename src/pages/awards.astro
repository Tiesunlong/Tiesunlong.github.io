---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import { awards, profile } from '../lib/data';
import { plural } from '../lib/format';
import { renderInline } from '../lib/markdown';

const byYear = [...awards.reduce((m, a) => m.set(a.year, [...(m.get(a.year) ?? []), a]), new Map<string, typeof awards>())];
---

<Base
  title="Awards"
  description={`Honours, scholarships and awards received by ${profile.name}.`}
>
  <PageHead eyebrow={plural(awards.length, 'honour')} title="Awards" lede="Scholarships, honours and recognitions." />

  <div class="container">
    {
      awards.length === 0 ? (
        <p class="muted">No awards listed yet.</p>
      ) : (
        <ol class="years" role="list">
          {byYear.map(([year, items]) => (
            <li class="year">
              <h2 class="year__label">{year}</h2>
              <ul class="items" role="list">
                {items.map((a) => (
                  <li class="award card spotlight reveal">
                    <span class="award__icon" aria-hidden="true">
                      <Icon name="medal" />
                    </span>
                    <div class="award__body">
                      <h3 class="award__title">{a.title}</h3>
                      {a.issuer && <p class="award__issuer">{a.issuer}</p>}
                      {a.note && <p class="award__note" set:html={renderInline(a.note)} />}
                    </div>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Base>

<style>
  @layer components {
    .years {
      display: grid;
      gap: 2.5rem;
    }
    .year {
      display: grid;
      gap: 1rem 2rem;
    }
    @media (min-width: 60rem) {
      .year {
        grid-template-columns: 8rem minmax(0, 1fr);
      }
      .year__label {
        position: sticky;
        top: 6.5rem;
        align-self: start;
      }
    }
    .year__label {
      font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
      font-weight: 360;
      letter-spacing: -0.04em;
      color: var(--ink-3);
      line-height: 1;
    }
    .items {
      display: grid;
      gap: 0.75rem;
    }
    .award {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1rem;
      padding: 1.25rem 1.4rem;
    }
    .award__icon {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: var(--r-m);
      background: var(--accent-soft);
      color: var(--accent-on-soft);
      font-size: 1.25rem;
    }
    .award__title {
      font-size: var(--step-1);
      font-weight: 520;
      line-height: 1.3;
    }
    .award__issuer {
      margin-top: 0.2rem;
      font-size: var(--step--1);
      font-weight: 550;
      color: var(--ink-2);
    }
    .award__note {
      margin-top: 0.5rem;
      max-width: 65ch;
      font-size: var(--step--1);
      color: var(--ink-2);
    }
  }
</style>
